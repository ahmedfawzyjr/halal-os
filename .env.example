# Halal OS - Web & Desktop Environment Variables

# Web Shell & API Backend
VITE_HALAL_OS_ENV=development
VITE_API_BASE_URL=https://api.halalos.org/v2
VITE_PRAYER_API_ENDPOINT=https://api.aladhan.com/v1

# Security & Content Filtering Proxy
HALAL_PROXY_ENABLED=true
HALAL_DNS_FILTER_PORT=5353
HALAL_CONTENT_GUARD_STRICTNESS=high

# Storage & Offline Sync
ENABLE_INDEXEDDB_PERSISTENCE=true
MAX_LOCAL_FS_QUOTA_MB=2048

# Telemetry (Strictly opt-in, zero PII)
HALAL_TELEMETRY_ENABLED=false
